# Copy to .env for local development. Values match docker-compose.yml.
# These are development credentials and are meant to be in the repository.

DATABASE_URL=postgres://comms:comms@localhost:5432/comms?sslmode=disable
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=comms
S3_SECRET_KEY=commsdevpassword
S3_BUCKET=attachments

API_ADDR=:8080

# Which origins may open a WebSocket. Empty means same-origin only, which is what the
# dev server's /v1 proxy gives you. Needed only if the client is served from somewhere
# the api is not: ALLOWED_ORIGINS=https://comms.example.com
# ALLOWED_ORIGINS=

SFU_ADDR=:8090
SFU_UDP_PORT_MIN=50000
SFU_UDP_PORT_MAX=50100

# What ICE candidates advertise, for a media node behind a one-to-one NAT — a cloud
# instance, or a machine behind a home router. Without it the node offers only the
# address it sees on its own interface, which nobody outside that network can reach.
# The UDP range above must be open and forwarded to it as well.
# SFU_PUBLIC_IP=203.0.113.10

# Where api forwards call media. Unset means "in this process", which is what one
# api node on a laptop wants — no second process to run. Set it, and forwarding
# moves to cmd/sfu, which is what makes a call joinable from more than one api
# node. scripts/e2e.sh sets it; uncomment to develop against the split.
# SFU_URL=http://localhost:8090

# debug, info, warn, error
LOG_LEVEL=info

# Tracing is off unless this is set, because NF-15 says the system starts locally
# with no cloud dependencies. Spans are created either way and go nowhere. Point it
# at a collector to see them:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
